_schema-version: "3.2"
ID: nshtml5module-uat

extends: nshtml5module

resources:

  - name: nshtml5module-destination-service
    parameters:
      service-name: nshtml5module-destination-service-uat

  - name: nshtml5module-uaa
    parameters:
      service-name: nshtml5module-xsuaa-service-uat
      config:
        xsappname: nshtml5module-uat

  - name: nshtml5module-repo-host
    parameters:
      service-name: nshtml5module-html5-service-uat

modules:
  - name: nshtml5module-destination-content
    parameters:
      content:
        instance:
          destinations:
            - Name: nshtml5module_html_repo_host
              ServiceInstanceName: nshtml5module-html5-service-uat
              ServiceKeyName: nshtml5module-repo-host-key

            - Name: nshtml5module_uaa
              ServiceInstanceName: nshtml5module-xsuaa-service-uat
              ServiceKeyName: nshtml5module-uaa-key